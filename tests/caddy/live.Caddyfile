# The harness's test Caddy, normal mode: it injects the proxy secret, as the fleet vhost does.
# Caddy runs in the harness's temporary directory, so the relative socket paths land there.
# expired.Caddyfile and loginpage.Caddyfile keep the same sockets, so `caddy reload` through the
# admin socket swaps between the three without dropping the listener.
{
	admin unix/caddy-admin.sock
	auto_https off
	persist_config off
}

http://127.0.0.1:18443 {
	bind unix/caddy.sock|0600
	handle /oauth2/* {
		respond "signed in" 200
	}
	handle {
		reverse_proxy 127.0.0.1:18090 {
			header_up X-Workbench-Proxy-Secret {env.CADDY_UPSTREAM_SECRET_WORKBENCH}
			stream_close_delay 5m
		}
	}
}
