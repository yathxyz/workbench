# Test Caddy for tests/harness.py: the same header_up line the deployed proxy uses. The secret
# is read from Caddy's environment on every request, so it never appears in this file.
#
# Caddy listens only on a 0600 unix socket inside the harness's 0700 directory. A TCP
# listener would add the secret for every local user (and every host that can reach the
# port), so only the harness user can reach it; a browser gets there through
# `ssh -L 18443:<socket> <host>`, which keeps Host and Origin at 127.0.0.1:18443.
{
	admin unix/{$WB_CADDY_ADMIN}
	auto_https off
	persist_config off
}

http://127.0.0.1:18443 {
	bind unix/{$WB_CADDY_SOCKET}|0600
	reverse_proxy 127.0.0.1:18090 {
		header_up X-Workbench-Proxy-Secret {env.CADDY_UPSTREAM_SECRET_WORKBENCH}
	}
}
